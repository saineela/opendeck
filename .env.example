# ============================================================================
# OpenDeck — environment configuration
#
# Copy this file to `.env` next to it (`webapp/.env`) or to `webapp/server/.env`.
# The server loads whichever exists on startup; variables already set in the
# shell always win. Restart the server after editing.
#
#   cp .env.example .env
#
# With Docker Compose this same file is read by `docker compose up`.
# ============================================================================

# ----------------------------------------------------------------------------
# Required in production (NODE_ENV=production)
# ----------------------------------------------------------------------------

# Signs session cookies and OAuth state cookies, and derives the AES-256-GCM
# key that encrypts YouTube Music tokens at rest. Must be >= 32 chars in
# production. Generate one with:
#   openssl rand -hex 32
#   # or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ----------------------------------------------------------------------------
# Accounts
# ----------------------------------------------------------------------------

# Password sign-in. On by default; set false to disable password-based login
# (including the TOTP second-factor step) without disabling Google/OIDC login.
PASSWORD_LOGIN_ENABLED=true

# Email + password account creation. On by default.
#   ALLOW_REGISTRATION=true   everyone can create an account
#   ALLOW_REGISTRATION=false  sign-up is closed (existing accounts can still sign in)
# This is only the baseline: an admin can open/close self-service sign-up at
# runtime from Settings -> Admin -> Account creation, which overrides it.
ALLOW_REGISTRATION=true

# Optional: require this exact code during registration (useful for a private
# instance you share with a few people). Leave empty for open sign-up.
#INVITE_CODE=

# Label shown in authenticator apps when enrolling in two-step verification.
#TOTP_ISSUER=OpenDeck

# Comma-separated email addresses granted (and kept) the admin role at
# sign-in. The first account created on a fresh instance is always admin;
# everyone else is a regular user until promoted in Settings -> Admin.
#ADMIN_EMAILS=owner@example.com

# ----------------------------------------------------------------------------
# Sign-in provider - any OpenID Connect IdP (optional)
# ----------------------------------------------------------------------------
#
# Password accounts work without any of this. Configure it to show the
# provider button on the sign-in page (/login). OAUTH_* are preferred;
# GOOGLE_* remain as aliases and apply when the OAUTH_* pair is absent.
# Admins can also set all of this at runtime in Settings -> Admin ->
# Sign-in provider (stored in the database; wins over these values).
# For the "Continue with Google" button:
#   Google Cloud Console → APIs & Services → Credentials → OAuth client ID
#   → Web application.
#   Authorized redirect URI:  http://localhost:4000/api/auth/google/callback
#                            (or https://your-domain/api/auth/google/callback)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------

# development | production | test  (default: development)
#NODE_ENV=development

# TCP port for the API + static client  (default: 4000).
# Must be a real port: absent, empty, 0, or malformed values fall back to 4000
# (an ephemeral port would break the derived OAuth redirect URI).
PORT=4000

# Public origin of this server. Used to build the OAuth redirect URI and to
# decide whether cookies get the Secure attribute. No trailing slash.
# Behind a proxy use the external https URL, e.g. https://music.example.com
APP_URL=http://localhost:4000

# Where the SQLite database (app.db) and the generated dev secret are stored.
# Relative paths resolve against the process working directory.
# In Docker this defaults to /data (the named volume in docker-compose.yml).
#DATA_DIR=.data
#DB_PATH=.data/app.db

# Log verbosity: debug | info | warn | error  (default: info)
#LOG_LEVEL=info

# Set to 1 (or true) when running behind a reverse proxy so rate limiting and
# audit logs see real client IPs instead of the proxy's address.
#TRUST_PROXY=true

# Set to 0 to run API-only (do not serve client/dist).
#SERVE_CLIENT=1

# ----------------------------------------------------------------------------
# Google sign-in customization (optional)
# ----------------------------------------------------------------------------

# Display name for the provider button (default: Google).
#OAUTH_PROVIDER_NAME=Google

# OpenID discovery document - required for non-Google IdPs, e.g. Keycloak:
#   https://keycloak.example.com/realms/your-realm/.well-known/openid-configuration
# Mainly used for tests that point the app at a mock identity provider.
#OAUTH_DISCOVERY=https://accounts.google.com/.well-known/openid-configuration

# Comma-separated OAuth scopes requested at sign-in.
#OAUTH_SCOPES=openid email profile

# ----------------------------------------------------------------------------
# Advanced (optional)
# ----------------------------------------------------------------------------

# Extra hostnames the /api/yt/proxy endpoint is allowed to forward to,
# comma separated (on top of the built-in YouTube allowlist).
#YT_PROXY_EXTRA_HOSTS=

# ----------------------------------------------------------------------------
# Docker Compose only
# ----------------------------------------------------------------------------

# Host port published by docker-compose.yml (container always listens on 4000).
#HOST_PORT=4000

# ----------------------------------------------------------------------------
# Client build only — put these in webapp/client/.env.local
# ----------------------------------------------------------------------------
# Where the Vite dev server proxies /api requests to (default: http://localhost:4000)
#VITE_API_TARGET=http://localhost:4000
# Where "source" / "report an issue" links point (defaults to the reference
# project, 2latemc/JustAnotherMusicClient). Set this to your own fork.
#VITE_REPOSITORY_URL=
